{
  "name": "@auracode/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The auracode desktop app: React UI for the Tauri shell in src-tauri.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test scripts/build-env.test.mjs && vitest run",
    "check:orbit": "node scripts/check-orbit.mjs",
    "check:setup": "node scripts/check-setup.mjs",
    "tauri": "tauri",
    "bundle": "node scripts/bundle.mjs",
    "signing": "sh scripts/macos-signing.sh"
  },
  "dependencies": {
    "@auracode/ui": "workspace:*",
    "@tanstack/react-virtual": "3.14.22",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.55.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
