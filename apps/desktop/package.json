{
  "name": "@auracode/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The auracode desktop app: React UI for the Tauri shell in src-tauri.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "tauri": "tauri",
    "bundle": "node scripts/bundle.mjs",
    "signing": "sh scripts/macos-signing.sh"
  },
  "dependencies": {
    "@auracode/ui": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
