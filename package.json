{
  "name": "auracode",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @auracode/desktop tauri dev",
    "bundle": "pnpm --filter @auracode/desktop bundle",
    "signing": "pnpm --filter @auracode/desktop signing",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "7.0.2"
  }
}
