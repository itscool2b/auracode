{
  "name": "@auracode/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aura design system shared by the auracode desktop app and auracode.si: tokens, fonts, glass, motion, Orb, AuraField.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./orbit": "./src/orbit/index.ts",
    "./orbit.css": "./src/orbit/orbit.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "ogl": "1.0.11"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.0.5"
  }
}
